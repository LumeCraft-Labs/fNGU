    barrier();

    const ivec2 output_pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 output_size = ivec2(textureSize(LUMA_HIGH_FINAL_raw, 0).x / 3, textureSize(LUMA_HIGH_FINAL_raw, 0).y) + ivec2(2);
