//!HOOK LUMA
//!BIND HOOKED
//!BIND LUMA_SCALE_Y
//!BIND LUMA_DENSE
//!BIND LUMA_ADD_CONSTANTS
//!DESC [fNGU_Sharp_onlyHD_x4] 720p 4x dense add
//!WIDTH HOOKED.w 4 *
//!HEIGHT HOOKED.h 4 *
//!WHEN HOOKED.w 1280 = HOOKED.h 720 = * OUTPUT.w HOOKED.w 2.2 * > OUTPUT.h HOOKED.h 2.2 * > * *
//!COMPONENTS 1
//!COMPUTE 4 16 4 16

shared vec4 ngu_luma_add_constants[2];

vec4 ngu_luma_add_u(int index) {
    return ngu_luma_add_constants[index];
}
float ngu_luma_add_store(float value) {
    return floor(clamp(value, 0.0, 1.0) * 65535.0 + 0.5) / 65535.0;
}
void hook() {
    for (uint i = gl_LocalInvocationIndex; i < 2u;
         i += gl_WorkGroupSize.x * gl_WorkGroupSize.y) {
        ngu_luma_add_constants[i] =
            texelFetch(LUMA_ADD_CONSTANTS, ivec2(int(i), 0), 0);
    }
    barrier();

    const ivec2 output_pixel = ivec2(gl_GlobalInvocationID.xy);
    if (output_pixel.x >= 5120 || output_pixel.y >= 2880) {
        return;
    }
    const vec2 output_pos = HOOKED_map(output_pixel);
    const vec4 inverse_dense_size = ngu_luma_add_u(0);
    const vec4 source_size = ngu_luma_add_u(1);
    const vec2 dense_pixel =
        floor(output_pos * source_size.xy + vec2(0.5)) + vec2(0.5);
    const ivec2 dense_index = clamp(
        ivec2(floor(
            dense_pixel *
            inverse_dense_size.xy *
            vec2(2562.0, 1442.0))),
        ivec2(0),
        ivec2(2561, 1441));
    const vec4 residual =
        texelFetch(LUMA_DENSE_raw, dense_index, 0);
    const vec2 phase = fract(output_pos * source_size.xy) - vec2(0.5);
    const float correction =
        phase.y < 0.0
            ? (phase.x < 0.0 ? residual.w : residual.z)
            : (phase.x < 0.0 ? residual.y : residual.x);
    const ivec2 base_index = clamp(
        ivec2(floor(output_pos * vec2(5120.0, 2880.0))),
        ivec2(0),
        ivec2(5119, 2879));
    const float base = texelFetch(LUMA_SCALE_Y_raw, base_index, 0).x;
    imageStore(
        out_image,
        output_pixel,
        vec4(ngu_luma_add_store(base + correction), 0.0, 0.0, 1.0));
}

