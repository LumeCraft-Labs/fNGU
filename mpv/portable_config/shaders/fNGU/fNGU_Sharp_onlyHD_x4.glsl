//!HOOK LUMA
//!BIND HOOKED
//!BIND LUMA_UP_FEATURES
//!BIND LUMA_CONVERT_CONSTANTS
//!SAVE LUMA_CONVERTED_FEATURES
//!DESC [fNGU_Sharp_onlyHD_x4] 720p 4x convert 3-pane
//!WIDTH HOOKED.w 6 *
//!HEIGHT HOOKED.h 2 *
//!WHEN HOOKED.w 1280 = HOOKED.h 720 = * OUTPUT.w HOOKED.w 2.2 * > OUTPUT.h HOOKED.h 2.2 * > * *
//!COMPONENTS 4
//!COMPUTE 12 16 4 16

shared vec4 ngu_luma_convert_constants[6];

vec4 ngu_luma_convert_u(int feature, int index) {
    return ngu_luma_convert_constants[feature * 2 + index];
}
vec4 ngu_luma_up_fetch(int feature, int part, ivec2 pixel) {
    const int plane = feature * 4 + part;
    return texelFetch(
        LUMA_UP_FEATURES_raw,
        ivec2(pixel.x * 12 + plane, pixel.y),
        0);
}
void hook() {
    const uint thread_count =
        gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;
    for (uint i = gl_LocalInvocationIndex; i < 6u; i += thread_count) {
        const int feature = int(i / 2u);
        const int index = int(i - uint(feature) * 2u);
        ngu_luma_convert_constants[i] = texelFetch(
            LUMA_CONVERT_CONSTANTS,
            ivec2(index, feature),
            0);
    }
    barrier();

    const ivec2 logical_pixel = ivec2(gl_GlobalInvocationID.xy);
    if (logical_pixel.x >= 2560 || logical_pixel.y >= 1440) {
        return;
    }
    const ivec2 packed = logical_pixel * ivec2(3, 1);
    const vec2 texcoord =
        (vec2(logical_pixel) + vec2(0.5)) / vec2(2560.0, 1440.0);
    for (int feature = 0; feature < 3; ++feature) {
        const vec4 inverse_size = ngu_luma_convert_u(feature, 0);
        const vec4 source_size = ngu_luma_convert_u(feature, 1);
        const vec2 source = texcoord * source_size.xy;
        const ivec2 base = ivec2(
            floor(source + vec2(0.5)));
        const vec2 sample_fraction = fract(source);
        int part;
        if (sample_fraction.x < 0.5 && sample_fraction.y < 0.5)
            part = 3;
        else if (sample_fraction.x >= 0.5 && sample_fraction.y < 0.5)
            part = 2;
        else if (sample_fraction.x < 0.5 && sample_fraction.y >= 0.5)
            part = 1;
        else
            part = 0;
        const vec2 uv = (vec2(base) + vec2(0.5)) * inverse_size.xy;
        const ivec2 upsample_pixel = clamp(
            ivec2(floor(uv * vec2(1282.0, 722.0))),
            ivec2(0),
            ivec2(1281, 721));
        imageStore(
            out_image,
            packed + ivec2(feature, 0),
            ngu_luma_up_fetch(feature, part, upsample_pixel));
    }
}

